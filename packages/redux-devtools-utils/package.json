    "immutable": "^5.1.9",
    "jsan": "^3.1.14",
    "nanoid": "^6.0.1",
    "redux": "^5.0.1"
  },
  "devDependencies": {
    "@types/jsan": "^3.1.5",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@redux-devtools/core": "workspace:^",
    "immutable": "^5.1.9",
    "redux": "^4.0.0 || ^5.0.0"
  }
}
